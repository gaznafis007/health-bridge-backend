enum MedicineStatus {
  ACTIVE
  DISCONTINUED
  OUT_OF_STOCK
}

enum OrderPaymentMethod {
  ONLINE
  CASH
}

enum OrderPaymentStatus {
  PENDING
  PENDING_CASH
  PAID
  FAILED
}

enum DeliveryStatus {
  PENDING
  CONFIRMED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum StockLogAction {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  EXPIRY
}

model MedicineCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())

  medicines   Medicine[]

  @@map("medicine_categories")
}

model Medicine {
  id                   String         @id @default(uuid()) @db.Uuid
  categoryId           String         @db.Uuid
  name                 String         @unique
  genericName          String?
  manufacturer         String?
  price                Decimal        @db.Decimal(12, 2)
  stockQuantity        Int
  composition          String?
  sideEffects          String?
  requiresPrescription Boolean        @default(false)
  expiryDate           DateTime?
  batchNumber          String?
  status               MedicineStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  category             MedicineCategory @relation(fields: [categoryId], references: [id])
  orderItems           OrderItem[]
  stockLogs            StockLog[]

  @@index([categoryId])
  @@index([status])
  @@map("medicines")
}

model Order {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String?            @db.Uuid
  guestSessionId   String?
  paymentId        String?            @unique @db.Uuid
  totalAmount      Decimal            @db.Decimal(12, 2)
  discountAmount   Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal            @default(0) @db.Decimal(12, 2)
  finalAmount      Decimal            @db.Decimal(12, 2)
  paymentMethod    OrderPaymentMethod
  paymentStatus    OrderPaymentStatus @default(PENDING)
  deliveryStatus   DeliveryStatus     @default(PENDING)
  deliveryAddress  String
  deliveryPhone    String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deliveredAt      DateTime?
  cancelledAt      DateTime?

  user             User?              @relation(fields: [userId], references: [id])
  guestSession     GuestSession?      @relation(fields: [guestSessionId], references: [sessionId])
  payment          Payment?           @relation(fields: [paymentId], references: [id])
  items            OrderItem[]

  @@index([userId, createdAt])
  @@index([guestSessionId])
  @@index([deliveryPhone, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @db.Uuid
  medicineId  String   @db.Uuid
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])
  medicine    Medicine @relation(fields: [medicineId], references: [id])

  @@index([orderId])
  @@index([medicineId])
  @@map("order_items")
}

model StockLog {
  id              String       @id @default(uuid()) @db.Uuid
  medicineId      String       @db.Uuid
  action          StockLogAction
  quantityChanged Int
  balanceBefore   Int
  balanceAfter    Int
  reason          String?
  reference       String?
  createdAt       DateTime     @default(now())

  medicine        Medicine     @relation(fields: [medicineId], references: [id])

  @@index([medicineId, createdAt])
  @@map("stock_logs")
}

model GuestSession {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @unique
  ipAddress      String?
  userAgent      String?
  lastActivityAt DateTime
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  orders         Order[]

  @@index([expiresAt])
  @@map("guest_sessions")
}
