enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  DISPATCHER
  DRIVER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  phone            String    @unique
  passwordHash     String
  role             UserRole
  firstName        String
  lastName         String
  profilePicture   String?
  isVerified       Boolean   @default(false)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  patientProfile            PatientProfile?
  doctorProfile             DoctorProfile?
  refreshTokens             RefreshToken[]
  userPreferences           UserPreference?
  notificationPreferences   NotificationPreference?
  appointmentsAsPatient     Appointment[]           @relation("AppointmentsPatient")
  appointmentsAsDoctor      Appointment[]           @relation("AppointmentsDoctor")
  telehealthAsPatient       TelehealthAppointment[] @relation("TelehealthPatient")
  telehealthAsDoctor        TelehealthAppointment[] @relation("TelehealthDoctor")
  prescriptionsAsPatient    Prescription[]          @relation("PrescriptionsPatient")
  prescriptionsAsDoctor     Prescription[]          @relation("PrescriptionsDoctor")
  orders                    Order[]
  testBookings              TestBooking[]
  ambulanceBookings         AmbulanceBooking[]
  driverProfile             DriverProfile?
  dispatchedAssignments     DispatchAssignment[]    @relation("DispatcherAssignments")
  payments                  Payment[]
  refunds                   Refund[]
  paymentMethods            PaymentMethod[]
  notificationLogs          NotificationLog[]

  @@map("users")
}

model PatientProfile {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @unique @db.Uuid
  bloodGroup       String?
  height           Float?
  weight           Float?
  dateOfBirth      DateTime?
  gender           Gender?
  emergencyContact String?
  emergencyPhone   String?
  medicalHistory   String?
  allergies        String?
  address          String?
  city             String?
  state            String?
  zipCode          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user             User      @relation(fields: [userId], references: [id])

  @@map("patient_profiles")
}

model DoctorProfile {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @unique @db.Uuid
  licenseNumber       String         @unique
  specialization      String
  qualification       String
  hospital            String?
  biography           String?
  consultationFee     Decimal        @db.Decimal(12, 2)
  status              DoctorStatus   @default(PENDING)
  isProvideTeleHealth   Boolean            @default(false)
  telehealthPresence    TelehealthPresence @default(OFFLINE)
  telehealthOnlineUntil DateTime?
  activeTelehealthId    String?            @unique @db.Uuid
  rating                Float              @default(0)
  totalRatings          Int                @default(0)
  approvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  user                  User                     @relation(fields: [userId], references: [id])
  availabilities        DoctorAvailability[]

  @@index([status, isProvideTeleHealth, telehealthPresence, activeTelehealthId])
  @@map("doctor_profiles")
}

enum DoctorStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TelehealthPresence {
  OFFLINE
  ONLINE
  BUSY
}

model DoctorAvailability {
  id                  String       @id @default(uuid()) @db.Uuid
  doctorId            String       @db.Uuid
  healthCenterId      String       @db.Uuid
  dayOfWeek           DayOfWeek?
  startTime           String
  endTime             String
  slotDurationMinutes Int
  isRecurring         Boolean      @default(true)
  specificDate        DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  doctor               DoctorProfile @relation(fields: [doctorId], references: [id])
  healthCenter         HealthCenter  @relation(fields: [healthCenterId], references: [id])
  appointmentsAsRule   Appointment[] @relation("AppointmentAvailabilityRule")

  @@index([doctorId, dayOfWeek])
  @@index([doctorId, specificDate])
  @@index([healthCenterId])
  @@map("doctor_availability")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  expiresAt  DateTime
  isRevoked  Boolean  @default(false)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @unique @db.Uuid
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  marketingEmails       Boolean  @default(false)
  appointmentReminders  Boolean  @default(true)
  orderUpdates          Boolean  @default(true)
  reportNotifications   Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id])

  @@map("user_preferences")
}
